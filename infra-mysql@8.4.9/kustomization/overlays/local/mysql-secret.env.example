# MySQL Secret Configuration Template
# 
# IMPORTANT: This file should NOT be committed to git!
# Copy this file to mysql-secret.env and update with your actual values.
#
# Format: KEY=VALUE (one per line)
#
# Required fields:
root-password=CHANGE_ME_TO_SECURE_PASSWORD

# Optional fields (uncomment and set if needed):
# user=username
# password=userpassword
# database=my_database
