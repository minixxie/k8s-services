#!/bin/bash

# Get the generated secret name (Kustomize adds hash suffix)
SECRET_NAME=$(kubectl get secrets --namespace infra-mysql -o jsonpath='{.items[?(@.type=="Opaque")].metadata.name}' | grep mysql | head -1)

if [ -z "$SECRET_NAME" ]; then
    echo "Error: MySQL secret not found. Have you deployed with kustomize?"
    echo "Run: kubectl apply -k kustomization/overlays/local/"
    exit 1
fi

kubectl run mysql-client-$(date +%s) --rm --tty -i --restart='Never' --image docker.io/mysql:8.2.0 --namespace infra-mysql --env MYSQL_ROOT_PASSWORD=$(kubectl get secret --namespace infra-mysql $SECRET_NAME -o jsonpath="{.data.mysql-root-password}" | base64 -d) --command -- bash -c 'mysql -h mysql.infra-mysql.svc.cluster.local -uroot -p"$MYSQL_ROOT_PASSWORD" -e "select utc_timestamp();"'
